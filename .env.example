# ==============================================================================
# HERITAGE ETHNIC LUXURY — CONFIGURATION ENVIRONMENT
# Keep credentials secure. Never commit live keys to public repos.
# ==============================================================================

FLASK_SECRET_KEY=heritage_luxury_staging_secret_key_2026_99x
PORT=5000

# ------------------------------------------------------------------------------
# 1. SHOPIFY INTEGRATION (Official Storefront GraphQL & Admin REST API)
# ------------------------------------------------------------------------------
# Your myshopify store handle, e.g. "heritage-couture.myshopify.com"
SHOPIFY_STORE_DOMAIN=

# Storefront API Access Token (For fetching live products, variants, collections)
SHOPIFY_STOREFRONT_ACCESS_TOKEN=

# Admin API Access Token (shpat_... For syncing 100% advance paid orders directly)
SHOPIFY_ADMIN_API_ACCESS_TOKEN=

# Shopify API Version (Default: 2024-01)
SHOPIFY_API_VERSION=2024-01

# ------------------------------------------------------------------------------
# 2. PAYMENT GATEWAYS (STRICT 100% ADVANCE PAYMENT ONLY)
# Permitted: Visa, Mastercard, JazzCash, Easypaisa
# ------------------------------------------------------------------------------

# Stripe / Shopify Payments Gateway (For Visa & Mastercard Worldwide)
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...

# JazzCash Merchant Integration
JAZZCASH_MERCHANT_ID=
JAZZCASH_PASSWORD=
JAZZCASH_INTEGRITY_SALT=

# Easypaisa Merchant Payment Gateway
EASYPAISA_STORE_ID=
EASYPAISA_HASH_KEY=

